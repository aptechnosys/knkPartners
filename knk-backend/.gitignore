# ==========================
# Dependencies
# ==========================
node_modules/
**/node_modules/

# ==========================
# Build Output
# ==========================
dist/
build/
coverage/
**/dist/
**/build/

# ==========================
# Environment Files
# ==========================
.env
.env.*
!.env.example
**/.env

# ==========================
# Uploads (Runtime Files)
# ==========================

# Ignore all runtime files inside uploads
uploads/*

# Allow Git to enter these directories
!uploads/proofs/
!uploads/bulk/

# Ignore everything inside proofs
uploads/proofs/*
# But keep .gitkeep
!uploads/proofs/.gitkeep

# Ignore everything inside bulk
uploads/bulk/*
# But keep .gitkeep
!uploads/bulk/.gitkeep

# Ignore avatar uploads completely
uploads/avatars/

# ==========================
# Deployment
# ==========================
.vercel/

# ==========================
# Logs
# ==========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# OS Files
# ==========================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================
# IDE
# ==========================
.vscode/
.idea/
*.swp
*.swo

# ==========================
# Cache
# ==========================
.cache/
.eslintcache

# ==========================
# Archives
# ==========================
*.zip
*.tar
*.gz
*.rar
*.7z

# ==========================
# Temporary Files
# ==========================
tmp/
temp/