# ==========================
# Uploads (Runtime Files)
# ==========================

# Ignore all files inside backend uploads
knk-backend/uploads/*

# Keep the proof and bulk directories
!knk-backend/uploads/proofs/
!knk-backend/uploads/bulk/

# Keep only the placeholder files
!knk-backend/uploads/proofs/.gitkeep
!knk-backend/uploads/bulk/.gitkeep

# Ignore avatar uploads
knk-backend/uploads/avatars/

